#!/bin/sh
# Beads sets core.hooksPath to this directory, which makes git ignore
# .git/hooks entirely — so this file, not scripts/pre-commit, is the gate that
# actually runs. It used to be a *copy* of that script, and the copy went
# stale: the project gate moved to `mix lint` (format + credo --strict +
# compile --warnings-as-errors) and grew a contract-test step, while this copy
# kept running plain `mix credo`. Commits passed locally and failed CI on
# --strict, which is precisely the seam scripts/pre-commit was written to
# close.
#
# It delegates now. One gate, defined once, and it cannot drift again.
# In a worktree this resolves to that worktree's copy of the script, so the
# gate always matches the code being committed.

REPO_ROOT=$(git rev-parse --show-toplevel)

if [ -x "$REPO_ROOT/scripts/pre-commit" ]; then
  "$REPO_ROOT/scripts/pre-commit" "$@" || exit $?
else
  echo "Pre-commit: WARNING — scripts/pre-commit not found or not executable."
  echo "The project gate did not run. Fix that before trusting this commit."
fi

# --- BEGIN BEADS INTEGRATION v1.0.4 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
    if [ $_bd_exit -eq 124 ]; then
      echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
      _bd_exit=0
    fi
  else
    bd hooks run pre-commit "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-commit'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.0.4 ---
